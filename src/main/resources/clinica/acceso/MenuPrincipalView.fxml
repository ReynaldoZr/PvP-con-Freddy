<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="460.0" prefWidth="760.0"
            xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="clinica.acceso.MenuPrincipalController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: #f3f4f6;">
            <padding>
                <Insets bottom="12.0" left="18.0" right="18.0" top="12.0"/>
            </padding>
            <Label fx:id="lblUsuario" text="Usuario: -">
                <font>
                    <Font name="System Bold" size="14.0"/>
                </font>
            </Label>
            <Label fx:id="lblRol" text="Rol: -" textFill="#374151"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#onCerrarSesion" text="Cerrar sesión"/>
        </HBox>
    </top>

    <left>
        <VBox prefWidth="190.0" spacing="10.0" style="-fx-background-color: #f9fafb;">
            <padding>
                <Insets bottom="16.0" left="14.0" right="14.0" top="16.0"/>
            </padding>
            <Label text="Módulos">
                <font>
                    <Font name="System Bold" size="13.0"/>
                </font>
            </Label>
            <Separator/>
            <Button fx:id="btnPacientes" maxWidth="Infinity" onAction="#onAbrirPacientes" text="Pacientes"/>
            <Button fx:id="btnCitas" maxWidth="Infinity" onAction="#onAbrirCitas" text="Citas"/>
            <Button fx:id="btnExpediente" maxWidth="Infinity" onAction="#onAbrirExpediente" text="Expediente"/>
            <Button fx:id="btnCobros" maxWidth="Infinity" onAction="#onAbrirCobros" text="Cobros"/>
        </VBox>
    </left>

    <center>
        <VBox alignment="TOP_LEFT" spacing="12.0">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0"/>
            </padding>
            <Label fx:id="lblModuloActual" text="Bienvenido">
                <font>
                    <Font name="System Bold" size="18.0"/>
                </font>
            </Label>
            <Label fx:id="lblDetalle" text="Selecciona un módulo disponible en el menú izquierdo."
                   textFill="#374151" wrapText="true"/>
        </VBox>
    </center>
</BorderPane>
