<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14.0" stylesheets="@../acceso/clinica.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="clinica.citas.CitasController">
    <padding>
        <Insets bottom="18.0" left="18.0" right="18.0" top="18.0"/>
    </padding>

    <VBox fx:id="panelAgendaForm" spacing="12.0" styleClass="content-card">
        <padding>
            <Insets bottom="16.0" left="18.0" right="18.0" top="16.0"/>
        </padding>
        <Label fx:id="lblTituloCitas" styleClass="module-title" text="Agenda de citas"/>

        <HBox fx:id="filaCampos1" spacing="10.0">
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="Paciente *"/>
                <ComboBox fx:id="cmbPaciente" maxWidth="Infinity" promptText="Selecciona paciente"/>
            </VBox>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="Médico *"/>
                <ComboBox fx:id="cmbMedico" maxWidth="Infinity" promptText="Selecciona médico"/>
            </VBox>
            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label styleClass="field-label" text="Consultorio *"/>
                <ComboBox fx:id="cmbConsultorio" maxWidth="Infinity" promptText="Selecciona consultorio"/>
            </VBox>
        </HBox>

        <HBox alignment="BOTTOM_LEFT" spacing="10.0">
            <VBox spacing="4.0">
                <Label styleClass="field-label" text="Fecha *"/>
                <DatePicker fx:id="dpFecha" onAction="#onCambiarFecha"/>
            </VBox>
            <VBox fx:id="boxHora" spacing="4.0">
                <Label styleClass="field-label" text="Bloque (30 min) *"/>
                <ComboBox fx:id="cmbHora" prefWidth="120.0" promptText="Hora"/>
            </VBox>
            <Button fx:id="btnAgendar" onAction="#onAgendar" styleClass="primary-button" text="Agendar cita"/>
            <Button onAction="#onRefrescarAgenda" text="Actualizar agenda"/>
            <Label fx:id="lblEstado" styleClass="module-detail" wrapText="true" HBox.hgrow="ALWAYS"/>
        </HBox>
    </VBox>

    <VBox spacing="10.0" styleClass="content-card" VBox.vgrow="ALWAYS">
        <padding>
            <Insets bottom="12.0" left="12.0" right="12.0" top="12.0"/>
        </padding>
        <TableView fx:id="tblCitas" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" prefWidth="55.0" text="ID"/>
                <TableColumn fx:id="colHora" prefWidth="85.0" text="Hora"/>
                <TableColumn fx:id="colPaciente" prefWidth="200.0" text="Paciente"/>
                <TableColumn fx:id="colMedico" prefWidth="180.0" text="Médico"/>
                <TableColumn fx:id="colConsultorio" prefWidth="140.0" text="Consultorio"/>
            </columns>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <Button fx:id="btnAbrirExpediente" onAction="#onAbrirExpediente"
                    styleClass="primary-button" text="Abrir en Expediente (ID cita)"/>
            <Button fx:id="btnAbrirCobros" onAction="#onAbrirCobros"
                    styleClass="primary-button" text="Abrir en Cobros (ID cita)"/>
        </HBox>
    </VBox>
</VBox>
