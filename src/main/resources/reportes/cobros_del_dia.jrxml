<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="cobros_del_dia" pageWidth="595" pageHeight="842"
              columnWidth="515" leftMargin="40" rightMargin="40"
              topMargin="35" bottomMargin="35" whenNoDataType="AllSectionsNoDetail">

    <parameter name="fecha" class="java.sql.Date"/>

    <queryString language="SQL"><![CDATA[
        SELECT CAST(registrado_en AS DATE) AS fecha,
               concepto,
               importe
        FROM cobros
        WHERE registrado_en >= CAST($P{fecha} AS DATE)
          AND registrado_en < (CAST($P{fecha} AS DATE) + INTERVAL '1 day')
        ORDER BY registrado_en, id
    ]]></queryString>

    <field name="fecha" class="java.sql.Date"/>
    <field name="concepto" class="java.lang.String"/>
    <field name="importe" class="java.math.BigDecimal"/>

    <variable name="totalDia" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{importe}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

    <title>
        <band height="75">
            <staticText>
                <reportElement x="0" y="0" width="515" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[REPORTE DE COBROS DEL DÍA]]></text>
            </staticText>
            <textField pattern="dd/MM/yyyy">
                <reportElement x="0" y="38" width="515" height="22"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$P{fecha}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="28">
            <staticText>
                <reportElement x="0" y="0" width="115" height="26" mode="Opaque" backcolor="#E8E8E8"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Fecha]]></text>
            </staticText>
            <staticText>
                <reportElement x="115" y="0" width="280" height="26" mode="Opaque" backcolor="#E8E8E8"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Concepto]]></text>
            </staticText>
            <staticText>
                <reportElement x="395" y="0" width="120" height="26" mode="Opaque" backcolor="#E8E8E8"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Importe (C$)]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="25">
            <textField pattern="dd/MM/yyyy">
                <reportElement x="0" y="0" width="115" height="24"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="115" y="0" width="280" height="24"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{concepto}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="395" y="0" width="120" height="24"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{importe}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="42">
            <staticText>
                <reportElement x="275" y="8" width="120" height="26" mode="Opaque" backcolor="#E8E8E8"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[TOTAL DEL DÍA]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="395" y="8" width="120" height="26" mode="Opaque" backcolor="#E8E8E8"/>
                <box><pen lineWidth="0.5"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{totalDia} == null ? java.math.BigDecimal.ZERO : $V{totalDia}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>
