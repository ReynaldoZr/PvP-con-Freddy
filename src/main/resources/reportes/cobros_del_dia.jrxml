<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="cobros_del_dia" pageWidth="595" pageHeight="842"
              columnWidth="515" leftMargin="40" rightMargin="40"
              topMargin="35" bottomMargin="35" whenNoDataType="AllSectionsNoDetail">

    <parameter name="fecha" class="java.sql.Date"/>

    <queryString language="SQL"><![CDATA[
        SELECT CAST(registrado_en AS DATE) AS fecha,
               concepto,
               importe
        FROM cobros
        WHERE registrado_en >= CAST($P{fecha} AS DATE)
          AND registrado_en < (CAST($P{fecha} AS DATE) + INTERVAL '1 day')
        ORDER BY registrado_en, id
    ]]></queryString>

    <field name="fecha" class="java.sql.Date"/>
    <field name="concepto" class="java.lang.String"/>
    <field name="importe" class="java.math.BigDecimal"/>

    <variable name="totalDia" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{importe}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

    <title>
        <band height="86">
            <image onErrorType="Blank">
                <reportElement x="0" y="4" width="215" height="62"/>
                <imageExpression><![CDATA["../clinica/clinicare-logo-completo.png"]]></imageExpression>
            </image>
            <staticText>
                <reportElement x="235" y="12" width="280" height="22" forecolor="#0F766E"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="15" isBold="true"/>
                </textElement>
                <text><![CDATA[REPORTE DE COBROS DEL DÍA]]></text>
            </staticText>
            <staticText>
                <reportElement x="285" y="36" width="145" height="18" forecolor="#475569"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <text><![CDATA[Fecha consultada:]]></text>
            </staticText>
            <textField pattern="dd/MM/yyyy">
                <reportElement x="435" y="36" width="80" height="18" forecolor="#0F172A"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{fecha}]]></textFieldExpression>
            </textField>
            <rectangle>
                <reportElement x="0" y="74" width="515" height="2" backcolor="#0F766E" forecolor="#0F766E"/>
            </rectangle>
        </band>
    </title>

    <columnHeader>
        <band height="30">
            <staticText>
                <reportElement x="0" y="0" width="110" height="28" mode="Opaque" backcolor="#134E4A" forecolor="#FFFFFF"/>
                <box leftPadding="8" rightPadding="8">
                    <pen lineWidth="0.5" lineColor="#134E4A"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Fecha]]></text>
            </staticText>
            <staticText>
                <reportElement x="110" y="0" width="275" height="28" mode="Opaque" backcolor="#134E4A" forecolor="#FFFFFF"/>
                <box leftPadding="8" rightPadding="8">
                    <pen lineWidth="0.5" lineColor="#134E4A"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Concepto]]></text>
            </staticText>
            <staticText>
                <reportElement x="385" y="0" width="130" height="28" mode="Opaque" backcolor="#134E4A" forecolor="#FFFFFF"/>
                <box leftPadding="8" rightPadding="8">
                    <pen lineWidth="0.5" lineColor="#134E4A"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Importe (C$)]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="26">
            <textField pattern="dd/MM/yyyy">
                <reportElement x="0" y="0" width="110" height="26" forecolor="#0F172A"/>
                <box leftPadding="8" rightPadding="8">
                    <pen lineWidth="0.5" lineColor="#CBD5E1"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="110" y="0" width="275" height="26" forecolor="#0F172A"/>
                <box leftPadding="8" rightPadding="8">
                    <pen lineWidth="0.5" lineColor="#CBD5E1"/>
                </box>
                <textElement verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{concepto}]]></textFieldExpression>
            </textField>
            <textField pattern="C$ #,##0.00">
                <reportElement x="385" y="0" width="130" height="26" forecolor="#0F172A"/>
                <box leftPadding="8" rightPadding="8">
                    <pen lineWidth="0.5" lineColor="#CBD5E1"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{importe}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="46">
            <staticText>
                <reportElement x="255" y="10" width="130" height="28" mode="Opaque" backcolor="#F0FDFA" forecolor="#134E4A"/>
                <box leftPadding="8" rightPadding="8">
                    <pen lineWidth="1.0" lineColor="#0F766E"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[TOTAL DEL DÍA]]></text>
            </staticText>
            <textField pattern="C$ #,##0.00">
                <reportElement x="385" y="10" width="130" height="28" mode="Opaque" backcolor="#F0FDFA" forecolor="#0F766E"/>
                <box leftPadding="8" rightPadding="8">
                    <pen lineWidth="1.0" lineColor="#0F766E"/>
                </box>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{totalDia} == null ? java.math.BigDecimal.ZERO : $V{totalDia}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

    <pageFooter>
        <band height="24">
            <textField pattern="dd/MM/yyyy HH:mm">
                <reportElement x="0" y="6" width="250" height="16" forecolor="#64748B"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="365" y="6" width="150" height="16" forecolor="#64748B"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>
