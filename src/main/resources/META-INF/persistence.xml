<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.2">
    <persistence-unit name="clinicaPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>clinica.acceso.Usuario</class>
        <class>clinica.pacientes.Paciente</class>
        <class>clinica.citas.Consultorio</class>
        <class>clinica.citas.Cita</class>

        <properties>
            <!-- Driver PostgreSQL; URL, usuario y clave se leen desde variables de entorno en JPAUtil -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>

            <!-- Valida que las entidades coincidan con base_clinica.sql sin alterar tablas -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
